    {
      "id": "ar-a1-01",
      "minutes": 7,
      "dialogue": [
        {
          "id": "ar-a1-01-d1",
          "speaker": "سارة",
          "text": "مرحبا! أنا سارة.",
          "translit": "marḥaban! ana sāra."
        },
        {
          "id": "ar-a1-01-d2",
          "speaker": "ماركو",
          "text": "أهلا يا سارة! اسمي ماركو.",
          "translit": "ahlan yā sāra! ismī mārkū."
        },
        {
          "id": "ar-a1-01-d3",
          "speaker": "سارة",
          "text": "من أين أنت؟",
          "translit": "min ayna anta?"
        },
        {
          "id": "ar-a1-01-d4",
          "speaker": "ماركو",
          "text": "أنا من إيطاليا. وأنتِ؟",
          "translit": "ana min īṭāliyā. wa-anti?"
        },
        {
          "id": "ar-a1-01-d5",
          "speaker": "سارة",
          "text": "أنا من الأقصر. تشرفنا!",
          "translit": "ana min al-uqṣur. tasharrafnā!"
        },
        {
          "id": "ar-a1-01-d6",
          "speaker": "ماركو",
          "text": "وأنا أيضا! إلى اللقاء.",
          "translit": "wa-ana ayḍan! ilā al-liqāʾ."
        }
      ],
      "vocabulary": [
        {
          "id": "ar-a1-01-v1",
          "text": "صباح الخير",
          "translit": "ṣabāḥ al-khayr",
          "accept": [
            "ṣabāḥ al-khayr",
            "sabah al-khayr"
          ]
        },
        {
          "id": "ar-a1-01-v2",
          "text": "مساء الخير",
          "translit": "masāʾ al-khayr",
          "accept": [
            "masāʾ al-khayr",
            "masa' al-khayr"
          ]
        },
        {
          "id": "ar-a1-01-v3",
          "text": "مع السلامة",
          "translit": "maʿa as-salāma",
          "accept": [
            "maʿa as-salāma",
            "maa as-salama"
          ]
        },
        {
          "id": "ar-a1-01-v4",
          "text": "ما اسمك؟",
          "translit": "mā ismuk?",
          "accept": [
            "mā ismuk?",
            "ma ismuk?"
          ]
        },
        {
          "id": "ar-a1-01-v5",
