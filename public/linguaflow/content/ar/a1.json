    {
      "id": "ar-a1-02",
      "minutes": 7,
      "dialogue": [
        {
          "id": "ar-a1-02-d1",
          "speaker": "البائعة",
          "text": "صباح الخير! ماذا تريد؟",
          "translit": "ṣabāḥ al-khayr! mādhā turīd?"
        },
        {
          "id": "ar-a1-02-d2",
          "speaker": "ماركو",
          "text": "أريد خبزا، من فضلك.",
          "translit": "urīdu khubzan, min faḍlik."
        },
        {
          "id": "ar-a1-02-d3",
          "speaker": "البائعة",
          "text": "تفضل. شيء آخر؟",
          "translit": "tafaḍḍal. shayʾ ākhar?"
        },
        {
          "id": "ar-a1-02-d4",
          "speaker": "ماركو",
          "text": "نعم، وثلاث تفاحات أيضا.",
          "translit": "naʿam, wa-thalāth tuffāḥāt ayḍan."
        },
        {
          "id": "ar-a1-02-d5",
          "speaker": "ماركو",
          "text": "بكم هذا؟",
          "translit": "bi-kam hādhā?"
