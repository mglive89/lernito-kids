        {
          "id": "ru-a1-03-d4",
          "speaker": "Марко",
          "text": "С лимоном. И стакан воды.",
          "translit": "S limonom. I stakan vody."
        },
        {
          "id": "ru-a1-03-d5",
          "speaker": "Марко",
          "text": "Можно заплатить?",
          "translit": "Mozhno zaplatit?"
        },
        {
          "id": "ru-a1-03-d6",
          "speaker": "Официант",
          "text": "Конечно. Триста рублей.",
          "translit": "Konechno. Trista rubley."
