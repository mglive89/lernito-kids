      "id": "ru-a1-01",
      "minutes": 7,
      "dialogue": [
        {
          "id": "ru-a1-01-d1",
          "speaker": "Маша",
          "text": "Привет! Я Маша.",
          "translit": "Privet! Ya Masha."
        },
        {
          "id": "ru-a1-01-d2",
          "speaker": "Марко",
          "text": "Привет, Маша! Меня зовут Марко.",
          "translit": "Privet, Masha! Menya zovut Marko."
        },
        {
          "id": "ru-a1-01-d3",
          "speaker": "Маша",
          "text": "Откуда ты?",
          "translit": "Otkuda ty?"
        },
        {
          "id": "ru-a1-01-d4",
          "speaker": "Марко",
          "text": "Я из Италии. А ты?",
          "translit": "Ya iz Italii. A ty?"
        },
        {
          "id": "ru-a1-01-d5",
          "speaker": "Маша",
          "text": "Я из Казани. Очень приятно!",
          "translit": "Ya iz Kazani. Ochen priyatno!"
        },
        {
          "id": "ru-a1-01-d6",
          "speaker": "Марко",
          "text": "Мне тоже! До встречи.",
          "translit": "Mne tozhe! Do vstrechi."
        }
      ],
      "vocabulary": [
        {
          "id": "ru-a1-01-v1",
          "text": "Доброе утро",
          "translit": "Dobroe utro",
          "accept": [
            "Dobroe utro"
          ]
        },
        {
          "id": "ru-a1-01-v2",
          "text": "Добрый вечер",
          "translit": "Dobryy vecher",
          "accept": [
            "Dobryy vecher"
          ]
        },
        {
          "id": "ru-a1-01-v3",
          "text": "До свидания",
          "translit": "Do svidaniya",
          "accept": [
            "Do svidaniya"
          ]
        },
        {
          "id": "ru-a1-01-v4",
          "text": "Как тебя зовут?",
          "translit": "Kak tebya zovut?",
          "accept": [
            "Kak tebya zovut?"
          ]
        },
        {
          "id": "ru-a1-01-v5",
          "text": "Спасибо",
          "translit": "Spasibo",
          "accept": [
            "Spasibo"
          ]
        },
        {
          "id": "ru-a1-01-v6",
          "text": "Пожалуйста",
          "translit": "Pozhaluysta",
          "accept": [
            "Pozhaluysta"
          ]
