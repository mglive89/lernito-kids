    {
      "id": "ru-a1-02",
      "minutes": 7,
      "dialogue": [
        {
          "id": "ru-a1-02-d1",
          "speaker": "Продавщица",
          "text": "Здравствуйте! Что вы хотите?",
          "translit": "Zdravstvuyte! Chto vy khotite?"
        },
        {
          "id": "ru-a1-02-d2",
          "speaker": "Марко",
          "text": "Дайте, пожалуйста, хлеб.",
          "translit": "Dayte, pozhaluysta, khleb."
        },
        {
          "id": "ru-a1-02-d3",
          "speaker": "Продавщица",
          "text": "Пожалуйста. Что-нибудь ещё?",
          "translit": "Pozhaluysta. Chto-nibud eshchyo?"
        },
        {
          "id": "ru-a1-02-d4",
          "speaker": "Марко",
          "text": "Да, ещё три яблока.",
          "translit": "Da, eshchyo tri yabloka."
        },
        {
          "id": "ru-a1-02-d5",
          "speaker": "Марко",
          "text": "Сколько стоит?",
          "translit": "Skolko stoit?"
        },
        {
          "id": "ru-a1-02-d6",
          "speaker": "Продавщица",
          "text": "Двести рублей.",
          "translit": "Dvesti rubley."
        }
      ],
