      "dialogue": [
        {
          "id": "el-a1-05-d1",
          "speaker": "Μάρκο",
          "text": "Συγγνώμη, πού είναι ο σταθμός;",
          "translit": "Singnómi, poú íne o stathmós?"
        },
        {
          "id": "el-a1-05-d2",
          "speaker": "Περαστική",
          "text": "Πηγαίνετε ευθεία.",
          "translit": "Pigénete evthía."
        },
        {
          "id": "el-a1-05-d3",
          "speaker": "Περαστική",
          "text": "Μετά στρίψτε αριστερά.",
          "translit": "Metá strípste aristerá."
        },
        {
          "id": "el-a1-05-d4",
          "speaker": "Μάρκο",
          "text": "Είναι μακριά;",
          "translit": "Íne makriá?"
        },
        {
          "id": "el-a1-05-d5",
          "speaker": "Περαστική",
          "text": "Όχι, πέντε λεπτά με τα πόδια.",
          "translit": "Óchi, pénte leptá me ta pódia."
        },
        {
          "id": "el-a1-05-d6",
          "speaker": "Μάρκο",
          "text": "Ευχαριστώ, αντίο!",
          "translit": "Evcharistó, antío!"
        }
      ],
