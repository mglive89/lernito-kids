    {
      "id": "el-a1-02",
      "minutes": 7,
      "dialogue": [
        {
          "id": "el-a1-02-d1",
          "speaker": "Πωλήτρια",
          "text": "Καλημέρα! Τι θα θέλατε;",
          "translit": "Kaliméra! Ti tha thélate?"
        },
        {
          "id": "el-a1-02-d2",
          "speaker": "Μάρκο",
          "text": "Θα ήθελα ένα ψωμί, παρακαλώ.",
          "translit": "Tha íthela éna psomí, parakaló."
        },
        {
          "id": "el-a1-02-d3",
          "speaker": "Πωλήτρια",
          "text": "Ορίστε. Κάτι άλλο;",
          "translit": "Oríste. Káti állo?"
        },
        {
          "id": "el-a1-02-d4",
          "speaker": "Μάρκο",
          "text": "Ναι, και τρία μήλα.",
          "translit": "Ne, ke tría míla."
        },
        {
          "id": "el-a1-02-d5",
          "speaker": "Μάρκο",
          "text": "Πόσο κάνει;",
          "translit": "Póso káni?"
        },
        {
          "id": "el-a1-02-d6",
          "speaker": "Πωλήτρια",
          "text": "Τέσσερα ευρώ.",
          "translit": "Téssera evró."
        }
      ],
