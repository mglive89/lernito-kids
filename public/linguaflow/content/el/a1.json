          "translit": "Antío",
          "accept": [
            "Antío",
            "Antio"
          ]
        },
        {
          "id": "el-a1-01-v4",
          "text": "Πώς σε λένε;",
          "translit": "Pós se léne?",
          "accept": [
            "Pós se léne?",
            "Pos se lene?"
          ]
        },
        {
          "id": "el-a1-01-v5",
