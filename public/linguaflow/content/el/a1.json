    {
      "id": "el-a1-03",
      "minutes": 6,
      "dialogue": [
        {
          "id": "el-a1-03-d1",
          "speaker": "Σερβιτόρος",
          "text": "Καλημέρα! Τι θα πάρετε;",
          "translit": "Kaliméra! Ti tha párete?"
        },
        {
          "id": "el-a1-03-d2",
          "speaker": "Μάρκο",
          "text": "Ένα τσάι, παρακαλώ.",
          "translit": "Éna tsái, parakaló."
        },
        {
          "id": "el-a1-03-d3",
          "speaker": "Σερβιτόρος",
          "text": "Με γάλα ή με λεμόνι;",
          "translit": "Me gála í me lemóni?"
        },
        {
          "id": "el-a1-03-d4",
          "speaker": "Μάρκο",
          "text": "Με λεμόνι. Και ένα ποτήρι νερό.",
          "translit": "Me lemóni. Ke éna potíri neró."
        },
        {
          "id": "el-a1-03-d5",
          "speaker": "Μάρκο",
          "text": "Μπορώ να πληρώσω;",
          "translit": "Boró na pliróso?"
        },
        {
          "id": "el-a1-03-d6",
          "speaker": "Σερβιτόρος",
          "text": "Βεβαίως. Τρία ευρώ και πενήντα.",
          "translit": "Vevéos. Tría evró ke penínta."
        }
      ],
