    {
      "id": "el-a1-01",
      "minutes": 7,
      "dialogue": [
        {
          "id": "el-a1-01-d1",
          "speaker": "Ελένη",
          "text": "Γεια σου! Είμαι η Ελένη.",
          "translit": "Gia sou! Íme i Eléni."
        },
        {
          "id": "el-a1-01-d2",
          "speaker": "Μάρκο",
          "text": "Γεια σου, Ελένη! Με λένε Μάρκο.",
          "translit": "Gia sou, Eléni! Me léne Márko."
        },
        {
          "id": "el-a1-01-d3",
          "speaker": "Ελένη",
          "text": "Από πού είσαι;",
          "translit": "Apó poú íse?"
        },
        {
          "id": "el-a1-01-d4",
          "speaker": "Μάρκο",
          "text": "Είμαι από την Ιταλία. Εσύ;",
          "translit": "Íme apó tin Italía. Esí?"
        },
        {
          "id": "el-a1-01-d5",
          "speaker": "Ελένη",
          "text": "Εγώ είμαι από τη Θεσσαλονίκη. Χάρηκα!",
          "translit": "Egó íme apó ti Thessaloníki. Chárika!"
        },
        {
          "id": "el-a1-01-d6",
          "speaker": "Μάρκο",
          "text": "Κι εγώ! Τα λέμε σύντομα.",
          "translit": "Ki egó! Ta léme síntoma."
        }
      ],
      "vocabulary": [
        {
          "id": "el-a1-01-v1",
          "text": "Καλημέρα",
          "translit": "Kaliméra",
          "accept": [
            "Kaliméra",
            "Kalimera"
          ]
        },
        {
          "id": "el-a1-01-v2",
