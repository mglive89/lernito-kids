    {
      "id": "el-a1-04",
      "minutes": 6,
      "dialogue": [
        {
          "id": "el-a1-04-d1",
          "speaker": "Μάρκο",
          "text": "Συγγνώμη, πού είναι το ρύζι;",
          "translit": "Singnómi, poú íne to rízi?"
        },
        {
          "id": "el-a1-04-d2",
          "speaker": "Υπάλληλος",
          "text": "Το ρύζι είναι εκεί, δεξιά.",
          "translit": "To rízi íne ekí, dexiá."
        },
        {
          "id": "el-a1-04-d3",
          "speaker": "Μάρκο",
          "text": "Και τα αυγά;",
          "translit": "Ke ta avgá?"
        },
        {
          "id": "el-a1-04-d4",
          "speaker": "Υπάλληλος",
          "text": "Είναι δίπλα στο γάλα.",
          "translit": "Íne dípla sto gála."
        },
        {
          "id": "el-a1-04-d5",
          "speaker": "Μάρκο",
          "text": "Ευχαριστώ πολύ!",
          "translit": "Evcharistó polí!"
        },
        {
          "id": "el-a1-04-d6",
          "speaker": "Υπάλληλος",
          "text": "Τίποτα!",
          "translit": "Típota!"
        }
