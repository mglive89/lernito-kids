          "text": "Soy de Italia. ¿Y tú?"
        },
        {
          "id": "es-a1-01-d5",
          "speaker": "Lucía",
          "text": "Yo soy de Sevilla. ¡Encantada!"
        },
        {
          "id": "es-a1-01-d6",
          "speaker": "Marco",
          "text": "¡Encantado! Hasta pronto."
        }
