      "dialogue": [
        {
          "id": "ja-demo-01-d1",
          "speaker": "ゆき",
          "text": "こんにちは。わたしはゆきです。",
          "translit": "Konnichiwa. Watashi wa Yuki desu."
        },
        {
          "id": "ja-demo-01-d2",
          "speaker": "マルコ",
          "text": "こんにちは。マルコです。よろしくおねがいします。",
          "translit": "Konnichiwa. Maruko desu. Yoroshiku onegaishimasu."
        },
        {
          "id": "ja-demo-01-d3",
          "speaker": "ゆき",
          "text": "マルコさんはどこからきましたか。",
          "translit": "Maruko-san wa doko kara kimashita ka."
        },
        {
          "id": "ja-demo-01-d4",
          "speaker": "マルコ",
          "text": "イタリアからきました。",
          "translit": "Itaria kara kimashita."
        },
        {
          "id": "ja-demo-01-d5",
          "speaker": "ゆき",
          "text": "そうですか。どうぞよろしく。",
          "translit": "Sō desu ka. Dōzo yoroshiku."
        }
      ],
      "vocabulary": [
        {
          "id": "ja-demo-01-v1",
