      "dialogue": [
        {
          "id": "ja-a1-01-d1",
          "speaker": "ゆき",
          "text": "こんにちは。わたしはゆきです。",
          "translit": "Konnichiwa. Watashi wa Yuki desu."
        },
        {
          "id": "ja-a1-01-d2",
          "speaker": "マルコ",
          "text": "こんにちは、ゆきさん。マルコです。",
          "translit": "Konnichiwa, Yuki-san. Maruko desu."
        },
        {
          "id": "ja-a1-01-d3",
          "speaker": "ゆき",
          "text": "どこからきましたか。",
          "translit": "Doko kara kimashita ka."
        },
        {
          "id": "ja-a1-01-d4",
          "speaker": "マルコ",
          "text": "イタリアからきました。ゆきさんは？",
          "translit": "Itaria kara kimashita. Yuki-san wa?"
        },
        {
          "id": "ja-a1-01-d5",
          "speaker": "ゆき",
          "text": "わたしはおおさかからです。よろしく！",
          "translit": "Watashi wa Ōsaka kara desu. Yoroshiku!"
        },
        {
          "id": "ja-a1-01-d6",
          "speaker": "マルコ",
          "text": "こちらこそ！またね。",
          "translit": "Kochira koso! Mata ne."
        }
      ],
      "vocabulary": [
        {
          "id": "ja-a1-01-v1",
          "text": "おはようございます",
          "translit": "ohayō gozaimasu",
          "accept": [
            "ohayō gozaimasu",
