{
  "name": "lernito-kids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lernito Kids – installierbare Lern-PWA für Kindergarten und Grundschule",
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.1.0",
    "@fontsource/plus-jakarta-sans": "5.1.0",
    "@react-three/fiber": "8.17.10",
    "framer-motion": "11.11.17",
    "idb": "8.0.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tesseract.js": "5.1.1",
    "three": "0.170.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
