# Optional – im MVP NICHT erforderlich. Ohne diese Werte läuft Lernito vollständig lokal.
# Supabase (Elternkonten/Synchronisierung) – nur der öffentliche anon key gehört ins Frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# KI-Lernhilfe: URL eines eigenen, moderierten Server-Endpunkts (z. B. Supabase Edge Function).
# Niemals einen KI-API-Schlüssel hier eintragen – Schlüssel gehören ausschließlich auf den Server.
VITE_AI_PROXY_URL=
